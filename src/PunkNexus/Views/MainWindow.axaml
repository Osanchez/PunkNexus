<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PunkNexus.ViewModels"
        xmlns:views="using:PunkNexus.Views"
        xmlns:svc="using:PunkNexus.Services"
        x:Class="PunkNexus.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PUNK Nexus"
        Width="1120" Height="760"
        MinWidth="920" MinHeight="600"
        Background="{DynamicResource Base}"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <DataTemplate x:Key="SetupTemplate" DataType="vm:SetupViewModel">
      <views:SetupView />
    </DataTemplate>
    <DataTemplate x:Key="ModsTemplate" DataType="vm:ModsViewModel">
      <views:ModsView />
    </DataTemplate>
    <DataTemplate x:Key="ServersTemplate" DataType="vm:ServersViewModel">
      <views:ServersView />
    </DataTemplate>
    <DataTemplate x:Key="SettingsTemplate" DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
  </Window.Resources>

  <Panel>

    <!-- Setup gate: nothing else is reachable until a folder verifies. -->
    <ContentControl Content="{Binding Setup}"
                    ContentTemplate="{StaticResource SetupTemplate}"
                    IsVisible="{Binding IsSetupVisible}" />

    <Grid RowDefinitions="Auto,*" IsVisible="{Binding !IsSetupVisible}">

      <!-- ===================================================== header -->
      <Border Grid.Row="0" Background="{DynamicResource Surface}"
              BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="24,0">

          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                      VerticalAlignment="Center" Margin="0,10,28,10">
            <!-- Rendered at exactly 74x42 so the pixel grid is not resampled. -->
            <Image Source="avares://PunkNexus/Assets/wordmark-header.png"
                   Width="74" Height="42" Stretch="None" />
            <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" Classes="dim" FontSize="10"
                       VerticalAlignment="Bottom" Margin="0,0,0,4" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
            <RadioButton Classes="tab" GroupName="nav" Content="Mods"
                         IsChecked="{Binding IsModsTab, Mode=TwoWay}" />
            <RadioButton Classes="tab" GroupName="nav" Content="Servers"
                         IsChecked="{Binding IsServersTab, Mode=TwoWay}" />
            <RadioButton Classes="tab" GroupName="nav" Content="Settings"
                         IsChecked="{Binding IsSettingsTab, Mode=TwoWay}" />
          </StackPanel>

          <Border Grid.Column="2" Classes="pill" VerticalAlignment="Center"
                  ToolTip.Tip="{Binding Session.Path}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource Success}" />
              <TextBlock Text="Install verified" />
            </StackPanel>
          </Border>

        </Grid>
      </Border>

      <!-- ===================================================== pages -->
      <Panel Grid.Row="1">
        <ContentControl Content="{Binding Mods}"
                        ContentTemplate="{StaticResource ModsTemplate}"
                        IsVisible="{Binding IsModsTab}" />
        <ContentControl Content="{Binding Servers}"
                        ContentTemplate="{StaticResource ServersTemplate}"
                        IsVisible="{Binding IsServersTab}" />
        <ContentControl Content="{Binding SettingsPage}"
                        ContentTemplate="{StaticResource SettingsTemplate}"
                        IsVisible="{Binding IsSettingsTab}" />
      </Panel>

    </Grid>

    <!-- ===================================================== modal overlay -->
    <!-- Above every page, including setup: the disclaimer has to gate the whole app. -->
    <Border IsVisible="{Binding Dialogs.IsOpen}" Background="#D6000000">
      <Border Classes="card" MaxWidth="580" Padding="0"
              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <StackPanel>

          <!-- severity strip -->
          <Border Height="3" CornerRadius="10,10,0,0"
                  Background="{DynamicResource Accent}" IsVisible="{Binding Dialogs.Current.IsInfo}" />
          <Border Height="3" CornerRadius="10,10,0,0"
                  Background="{DynamicResource Success}" IsVisible="{Binding Dialogs.Current.IsSuccess}" />
          <Border Height="3" CornerRadius="10,10,0,0"
                  Background="{DynamicResource Warning}" IsVisible="{Binding Dialogs.Current.IsWarning}" />
          <Border Height="3" CornerRadius="10,10,0,0"
                  Background="{DynamicResource Danger}" IsVisible="{Binding Dialogs.Current.IsDanger}" />

          <StackPanel Margin="24" Spacing="16">
            <TextBlock Classes="h2" Text="{Binding Dialogs.Current.Title}" />
            <TextBlock Text="{Binding Dialogs.Current.Message}" Classes="muted" FontSize="13" />

            <Border Background="{DynamicResource Base}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="6" Padding="14,12"
                    IsVisible="{Binding Dialogs.Current.HasDetails}">
              <ItemsControl ItemsSource="{Binding Dialogs.Current.Details}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="svc:DialogDetail">
                    <Grid ColumnDefinitions="18,*" Margin="0,3">
                      <TextBlock Grid.Column="0" Text="✓" FontWeight="Bold"
                                 Foreground="{DynamicResource Success}" IsVisible="{Binding IsOk}" />
                      <TextBlock Grid.Column="0" Text="✕" FontWeight="Bold"
                                 Foreground="{DynamicResource Danger}" IsVisible="{Binding IsBad}" />
                      <TextBlock Grid.Column="0" Text="•" FontWeight="Bold"
                                 Foreground="{DynamicResource TextDim}" IsVisible="{Binding IsNeutral}" />
                      <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12.5" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
              <Button Content="{Binding Dialogs.Current.DeclineText}"
                      IsVisible="{Binding Dialogs.Current.HasDecline}"
                      Command="{Binding Dialogs.DeclineCommand}" MinWidth="110" />
              <Button Classes="primary" Content="{Binding Dialogs.Current.AcceptText}"
                      Command="{Binding Dialogs.AcceptCommand}" MinWidth="130" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

  </Panel>
</Window>
