<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <!-- PUNK: near-black industrial ground, hot magenta for action, acid for signal. High
         contrast, few colors, no gradients competing with the content. -->
    <Color x:Key="PunkBaseColor">#0A0A0C</Color>
    <Color x:Key="PunkAccentColor">#FF2D6F</Color>

    <SolidColorBrush x:Key="Base" Color="#0A0A0C" />
    <SolidColorBrush x:Key="Surface" Color="#131317" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#1A1A20" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#20202A" />
    <SolidColorBrush x:Key="Border" Color="#26262F" />
    <SolidColorBrush x:Key="BorderStrong" Color="#3A3A47" />

    <SolidColorBrush x:Key="Text" Color="#ECECF1" />
    <SolidColorBrush x:Key="TextMuted" Color="#8B8B9A" />
    <SolidColorBrush x:Key="TextDim" Color="#5F5F6E" />

    <SolidColorBrush x:Key="Accent" Color="#FF2D6F" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF4D85" />
    <SolidColorBrush x:Key="AccentPressed" Color="#E01B58" />
    <SolidColorBrush x:Key="AccentDim" Color="#3A121F" />
    <SolidColorBrush x:Key="Acid" Color="#D6FF3F" />
    <SolidColorBrush x:Key="Danger" Color="#FF5C5C" />
    <SolidColorBrush x:Key="DangerDim" Color="#3A1616" />
    <SolidColorBrush x:Key="Success" Color="#46D98B" />
    <SolidColorBrush x:Key="Warning" Color="#FFB020" />
    <SolidColorBrush x:Key="WarningDim" Color="#3A2A0F" />
    <SolidColorBrush x:Key="SuccessDim" Color="#12301F" />

    <x:Double x:Key="RadiusSm">4</x:Double>
    <CornerRadius x:Key="Radius">6</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">10</CornerRadius>
  </Styles.Resources>

  <!-- ============================================================ typography -->

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="FontFamily" Value="Inter, $Default" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>

  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
  </Style>

  <!-- ================================================================ buttons -->

  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Fluent styles the presenter directly for every non-default state, and a setter on the Button
       loses to that. So each variant below paints PART_ContentPresenter explicitly. The variant is
       called "primary" rather than "accent" because Fluent already ships a Button.accent that
       paints itself the system accent color (blue) and would win. -->
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.5" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPressed}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerDim}" />
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerDim}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerDim}" />
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>

  <!-- Top navigation: a flat strip with an accent underline on the active tab. -->
  <Style Selector="RadioButton.tab">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="root" Background="Transparent" Padding="2,0"
                BorderThickness="0,0,0,2" BorderBrush="Transparent">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            Margin="14,14,14,11" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.tab:pointerover /template/ Border#root">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
  </Style>
  <Style Selector="RadioButton.tab:checked /template/ Border#root">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="RadioButton.tab:checked">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>

  <!-- ================================================================= inputs -->

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Base}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Base}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <!-- The dropdown itself is a popup outside the ComboBox's own template, so it keeps Fluent's
       light surface and blue selection unless it is styled separately. -->
  <Style Selector="ComboBox /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Base}" />
  </Style>
  <Style Selector="ComboBox /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
  </Style>

  <Style Selector="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentDim}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentDim}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentHover}" />
  </Style>

  <!-- Ping quality. Thresholds live in ServerEntry; these are only the colors. -->
  <Style Selector="TextBlock.pingGood"><Setter Property="Foreground" Value="{DynamicResource Success}" /></Style>
  <Style Selector="TextBlock.pingFair"><Setter Property="Foreground" Value="{DynamicResource Warning}" /></Style>
  <Style Selector="TextBlock.pingPoor"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- ================================================================= panels -->

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <Style Selector="Border.row">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="Border.banner">
    <Setter Property="Background" Value="{DynamicResource AccentDim}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="9,3" />
  </Style>

  <Style Selector="Border.pill > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- Coloured pills. Kept as classes rather than inline brushes so every badge in the app
       agrees on what amber means, and so a palette change lands everywhere at once. -->
  <Style Selector="Border.pill.warn">
    <Setter Property="Background" Value="{DynamicResource WarningDim}" />
  </Style>
  <Style Selector="Border.pill.warn > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
  </Style>

  <Style Selector="Border.pill.ok">
    <Setter Property="Background" Value="{DynamicResource SuccessDim}" />
  </Style>
  <Style Selector="Border.pill.ok > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Success}" />
  </Style>

  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource Border}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,4" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="Height" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

</Styles>
