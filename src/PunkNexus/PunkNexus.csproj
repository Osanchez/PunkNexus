<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PunkNexus</AssemblyName>
    <RootNamespace>PunkNexus</RootNamespace>
    <Version>0.1.0</Version>
    <Company>PunkNexus</Company>
    <Product>PUNK Nexus</Product>
    <Description>Mod browser and installer for PUNK.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/punknexus.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Avalonia's XAML loader and the JSON serializer both resolve types by name at runtime;
         trimming strips them and the app dies at first navigation. Keep it off. -->
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped inside the exe so a first run with no network still lists mods. -->
    <EmbeddedResource Include="../../manifest/mods.json" LogicalName="PunkNexus.Fallback.mods.json" />
    <EmbeddedResource Include="../../manifest/servers.json" LogicalName="PunkNexus.Fallback.servers.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.19" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.19" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <!-- Managed bindings only. The native steam_api64.dll is Valve's to distribute, not ours, so
         SteamBrowser loads the one that ships with the player's game install instead. -->
    <PackageReference Include="Steamworks.NET" Version="20.2.0" />
  </ItemGroup>

</Project>
